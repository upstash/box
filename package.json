{
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "changeset": "changeset",
    "ci:version": "changeset version && node packages/sdk/scripts/gen-version.mjs && node packages/cli/scripts/gen-version.mjs && pnpm install --lockfile-only",
    "ci:tag": "changeset tag",
    "lint": "pnpm -r lint",
    "ci:lint": "pnpm -r ci:lint"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "dotenv": "^17.3.1",
    "vitest": "^4.1.2"
  }
}
